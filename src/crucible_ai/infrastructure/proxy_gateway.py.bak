"""Async HTTP proxy gateway for upstream LLM relay."""

import json
import logging
import asyncio
from typing import Any, AsyncGenerator, Tuple
import httpx

from crucible_ai.infrastructure.storage.base import CacheBackend
from crucible_ai.domain.types import CacheEntry
import time

logger = logging.getLogger(__name__)


class ProxyGateway:
    """Proxy for upstream LLM provider relay."""

    def __init__(
        self,
        upstream_base_url: str = "https://api.openai.com/v1",
        upstream_api_key: str = "",
        cache_backend: CacheBackend | None = None,
        similarity_threshold: float = 0.92,
        max_retries: int = 3,
        timeout_seconds: float = 30.0,
    ):
        """Initialize proxy."""
        self.upstream_base_url = upstream_base_url
        self.upstream_api_key = upstream_api_key
        self.cache_backend = cache_backend
        self.similarity_threshold = similarity_threshold
        self.max_retries = max_retries
        self.timeout_seconds = timeout_seconds
        self.client = httpx.AsyncClient(timeout=timeout_seconds)

    async def call_upstream(
        self,
        request_body: dict[str, Any],
        cache_key: str,
    ) -> Tuple[str, dict[str, int]]:
        """Call upstream (non-streaming)."""
        url = f"{self.upstream_base_url}/chat/completions"
        headers = {
            "Authorization": f"Bearer {self.upstream_api_key}",
            "Content-Type": "application/json",
        }
        request_body = {k: v for k, v in request_body.items() if k != "stream"}
        request_body["stream"] = False

        for attempt in range(self.max_retries):
            try:
                response = await self.client.post(
                    url, json=request_body, headers=headers
                )
                if response.status_code == 200:
                    data = response.json()
                    content = data["choices"][0]["message"]["content"]
                    usage = data.get("usage", {})
                    if self.cache_backend:
                        try:
                            await self._cache_response(cache_key, content, usage)
                        except Exception as e:\n                            logger.warning(f"Cache failed: {e}")
                    return content, usage
                elif response.status_code == 429:
                    wait_time = 2 ** attempt
                    logger.warning(f"Rate limited (429). Retrying in {wait_time}s...")
                    await asyncio.sleep(wait_time)
                    continue
                elif response.status_code >= 500:
                    logger.warning(f"Upstream error {response.status_code}. Retrying...")
                    await asyncio.sleep(2 ** attempt)
                    continue
                else:
                    raise httpx.HTTPStatusError(
                        f"Upstream error {response.status_code}",
                        request=response.request,
                        response=response,
                    )
            except (httpx.TimeoutException, httpx.ConnectError) as e:\n                logger.warning(f"Connection error attempt {attempt + 1}: {e}")
                if attempt < self.max_retries - 1:
                    await asyncio.sleep(2 ** attempt)
                else:
                    raise
        raise RuntimeError(f"Max retries ({self.max_retries}) exhausted")

    async def stream_upstream(
        self,
        request_body: dict[str, Any],
        cache_key: str,
    ) -> AsyncGenerator[str, None]:
        """Stream response from upstream (SSE passthrough)."""
        url = f"{self.upstream_base_url}/chat/completions"
        headers = {
            "Authorization": f"Bearer {self.upstream_api_key}",
            "Content-Type": "application/json",
        }
        request_body = {k: v for k, v in request_body.items() if k != "stream"}
        request_body["stream"] = True

        try:
            async with self.client.stream(
                "POST", url, json=request_body, headers=headers
            ) as response:
                if response.status_code != 200:
                    error_text = await response.aread()
                    logger.error(f"Upstream error {response.status_code}: {error_text}")
                    yield f"data: {{'error': 'Upstream error {response.status_code}'}}"
                    return

                full_response = ""
                async for line in response.aiter_lines():
                    if not line.strip():
                        continue
                    if line.startswith("data: "):
                        data_str = line[6:].strip()
                        if data_str == "[DONE]":
                            if self.cache_backend and full_response:
                                try:
                                    await self._cache_response(
                                        cache_key, full_response, {}
                                    )
                                except Exception as e:\n                                    logger.warning(f"Cache failed: {e}")
                            yield "data: [DONE]"
                            break

                        try:
                            chunk = json.loads(data_str)
                            content = (
                                chunk.get("choices", [{}])[0]
                                .get("delta", {})
                                .get("content", "")
                            )
                            if content:
                                full_response += content
                            yield f"data: {data_str}"
                        except json.JSONDecodeError:
                            logger.warning(f"Failed to parse: {data_str}")
                            yield f"data: {data_str}"
        except Exception as e:\n            logger.error(f"Streaming error: {e}")
            yield f"data: {{'error': str(e)}}"

    async def _cache_response(
        self,
        cache_key: str,
        response_text: str,
        usage: dict[str, int],
    ) -> None:
        """Store response in cache."""
        if not self.cache_backend:
            return
        entry = CacheEntry(
            request_hash=cache_key,
            embedding_vector=[],
            response_text=response_text,
            finish_reason="stop",
            tokens_used=usage.get("completion_tokens", 0),
            cached_at=time.time(),
        )
        await self.cache_backend.store(entry)
        logger.debug(f"Cached response: {cache_key[:8]}...")

    async def close(self) -> None:
        """Close HTTP client."""
        await self.client.aclose()
